{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tlpt-cashier-test",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/",
      "/connect-reader",
      "/display"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "CASHIER_ENV": "staging",
    "OWNER_EMAIL": "blanchettemr@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "AUTH_MODE": "password"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tlpt-cashier-staging",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "env": {
    "production": {
      "name": "tlpt-cashier-staging",
      "vars": {
        "CASHIER_ENV": "production",
        "OWNER_EMAIL": "blanchettemr@gmail.com",
        "CF_ACCESS_TEAM_DOMAIN": "",
        "CF_ACCESS_AUD": "",
        "AUTH_MODE": "password"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tlpt-cashier",
          "database_id": "00000000-0000-4000-8000-000000000000",
          "migrations_dir": "drizzle"
        }
      ]
    }
  }
}
