{
  "name": "tlpt-cashier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/local-dev.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:live-sources": "node scripts/check-live-sources.mjs",
    "test:integration": "node scripts/test-integration.mjs && node scripts/test-closeout-integration.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "jose": "6.2.2",
    "lucide-react": "1.56.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  },
  "packageManager": "pnpm@11.25.0"
}
