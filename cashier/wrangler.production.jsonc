{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tlpt-cashier-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "minify": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/",
      "/connect-reader",
      "/display"
    ]
  },
  "observability": {
    "enabled": false
  },
  "vars": {
    "CASHIER_ENV": "production",
    "OWNER_EMAIL": "blanchettemr@gmail.com",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "AUTH_MODE": "password"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tlpt-cashier",
      "database_id": "9165ae68-16fa-4ce2-9b87-77019e52ef20",
      "migrations_dir": "drizzle"
    }
  ],
  "account_id": "4d5ea071300fa71b8fa947c06d8ba314",
  "keep_vars": true,
  "version_metadata": {
    "binding": "CASHIER_VERSION"
  }
}
