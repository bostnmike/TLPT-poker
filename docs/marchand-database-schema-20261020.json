  "field_definitions": {
    "Date": {
      "type": "Excel integer serial",
      "meaning": "Calendar date with no time fraction; mm/dd/yyyy display. 705 retains the printed original postponed date. Export date_iso for external consumers."
    },
    "Career Stat Basis": {
      "type": "StatBases catalog value",
      "meaning": "Unit and competition for existing Career Stat; never infer goal/point/assist from column position or number."
    },
    "Season Stat Basis": {
      "type": "StatBases catalog value",
      "meaning": "Unit and competition for existing Season Stat. Artifact300 is season assist5, not season point8."
    },
    "Goal Strength": {
      "type": "ESG / PPG / SHG / ENG / PS",
      "meaning": "One primary strength/goal modifier for the identified scoring event. PS takes precedence over misleading situation-code empty-net parsing."
    },
    "Game-Winning Goal": {
      "type": "0 or1 when scoring context exists; blank otherwise",
      "meaning": "Orthogonal flag; not additive with strength."
    },
    "Overtime Goal": {
      "type": "0 or1 when scoring context exists; blank otherwise",
      "meaning": "Orthogonal flag; not additive with strength."
    },
    "Recorded Scorer": {
      "type": "full name",
      "meaning": "Scorer of the goal event, not automatically Brad Marchand. Physical counts still depend on Puck Type."
    },
    "NHL Game ID": {
      "type": "text identifier",
      "meaning": "Official NHL primary game key;171registered played contexts.705 original postponed context intentionally blank."
    },
    "NHL Goal Event ID": {
      "type": "text identifier",
      "meaning": "Official primary event key paired with NHL Game ID.83contexts include81actualgoalpucks and48/313gameusedcontext; it is not proof of physical goal-puck type."
    },
    "Arena": {
      "type": "ArenaAliases catalog value",
      "meaning": "Preserved recorded game-date arena label. Multiple labels may refer to one PhysicalVenues building."
    },
    "ID": {
      "type": "positive unique integer",
      "meaning": "Current logical inventory identity. Old ID header spellings remain; current active ID overrides historical aliases."
    },
    "Puck Type": {
      "type": "PuckTypes catalog value",
      "meaning": "Physical classification. Count one physical puck once, even50two-goal puck or multiple category memberships."
    }
  },
